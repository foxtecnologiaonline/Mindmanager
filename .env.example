NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: só necessário se o host não enviar x-forwarded-host/proto
# corretamente (ex: atrás de alguns proxies). Usado para montar o link
# de confirmação de e-mail (emailRedirectTo).
NEXT_PUBLIC_SITE_URL=

# F1 — envio de WhatsApp (confirmação de agendamento + lembrete). Ordem
# de prioridade: ZapScript (se configurado) → Twilio (se configurado) →
# log no console (não quebra o agendamento, só não envia nada de fato).

# ZapScript (API pública v1) — preferencial. Crie uma API key com scope
# "messages:send" no painel ZapScript para ZAPSCRIPT_API_KEY, e pegue o
# ID do número conectado para ZAPSCRIPT_NUMBER_ID. ZAPSCRIPT_WEBHOOK_SECRET
# vem da resposta do POST /public/v1/webhooks (ver README). ZAPSCRIPT_BASE_URL
# é opcional (default https://api.zapscript.me).
ZAPSCRIPT_API_KEY=
ZAPSCRIPT_NUMBER_ID=
ZAPSCRIPT_WEBHOOK_SECRET=
ZAPSCRIPT_BASE_URL=

# Twilio — fallback, usado só se as variáveis do ZapScript acima não
# estiverem configuradas.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# F1 — cron de lembrete (/api/cron/reminders). A Vercel injeta
# automaticamente "Authorization: Bearer $CRON_SECRET" nas chamadas de
# vercel.json quando essa env var está configurada no projeto.
CRON_SECRET=

# F1 — necessária para o cron ler agendamentos de todos os tenants
# (contorna a RLS por tenant). Pegue em Project Settings > API no
# painel Supabase. NUNCA prefixe com NEXT_PUBLIC_ nem exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=
